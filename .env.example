# pgboss-scheduler — copy to .env, fill in, chmod 600.
#
# Nothing here has a default: the process refuses to boot on a missing secret
# rather than starting healthy and failing on the first job.

# Postgres. The bundled compose brings its own; POSTGRES_PASSWORD below must
# match the password in this URL. Point both elsewhere if you already run one.
DATABASE_URL=postgres://scheduler_app:CHANGEME@postgres:5432/scheduler
POSTGRES_USER=scheduler_app
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=scheduler

# Who may call this service: name:token pairs, comma separated. The NAME is
# recorded on every job the token enqueues, so give each caller its own.
#   openssl rand -hex 24
SCHEDULER_TOKENS=ops:CHANGEME,app-two:CHANGEME

# Signs every push delivery so a receiver can prove the request came from here.
#   openssl rand -hex 32
SCHEDULER_SIGNING_KEY=CHANGEME

# Only needed if you use `agent` targets — an HTTP agent runner exposing
# POST /api/runs. Leave unset and `url` targets work on their own.
# AGENT_RUNNER_URL=http://agent-runner:8010
# AGENT_RUNNER_PROJECT=default

# The container's wall clock. Schedule correctness does not depend on it.
TZ=UTC

# Optional, with the defaults shown.
# PORT=8020
# LOG_LEVEL=info
# SCHEDULER_DELIVERY_TIMEOUT_MS=30000
# SCHEDULER_AGENT_TIMEOUT_MS=300000
