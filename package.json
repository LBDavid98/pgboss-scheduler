{
  "name": "pgboss-scheduler",
  "version": "0.1.0",
  "private": false,
  "description": "Scheduled and queued work behind an HTTP API: pg-boss on Postgres, with push or pull delivery, signed deliveries, cron schedules and a dead-letter queue per queue.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build \\&\\& node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "test:unit": "npm run build:test && node --test dist-test/test/unit/*.test.js",
    "test:integration": "npm run build:test && node --test --test-timeout=240000 dist-test/test/integration/*.test.js",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "fastify": "5.6.1",
    "pg": "8.16.3",
    "pg-boss": "12.28.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.15.5",
    "typescript": "5.7.2"
  },
  "keywords": [
    "scheduler",
    "cron",
    "job-queue",
    "pg-boss",
    "postgres",
    "fastify",
    "webhooks",
    "typescript",
    "dead-letter-queue"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBDavid98/pgboss-scheduler.git"
  },
  "homepage": "https://github.com/LBDavid98/pgboss-scheduler#readme",
  "bugs": {
    "url": "https://github.com/LBDavid98/pgboss-scheduler/issues"
  }
}
